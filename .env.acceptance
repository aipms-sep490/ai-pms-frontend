# ==============================================================================
# AI-PMS Acceptance Environment Configuration (.env.acceptance)
# Prepared for FE2-G9 & Final Acceptance according to DECISIONS.md (Q6)
# ==============================================================================

VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:5080
VITE_DATA_MODE=api

# ------------------------------------------------------------------------------
# NHÓM 2: 16 Feature Flags ĐƯỢC BẬT CHO NGHIỆM THU (Tất cả endpoint backend sẵn sàng)
# ------------------------------------------------------------------------------

# 1. Trợ lý AI và phân tích (UC-097 / AI Advisory)
VITE_ENABLE_AI_ADVISORY=true

# 2. Lịch sử phân tích AI (UC-101 / AI Run History)
VITE_ENABLE_AI_RUN_HISTORY=true

# 3. Trợ lý AI học vụ (BE-13 / PR #132 / PR #100)
VITE_ENABLE_AI_ACADEMIC_ASSISTANT=true

# 4. Họp trực tuyến (Video Meeting)
VITE_ENABLE_VIDEO_MEETING=true

# 5. Họp định kỳ, điểm danh và biên bản họp (BE-06/N06/N07 Meeting Collaboration)
VITE_ENABLE_MEETING_COLLABORATION=true

# 6. Chat nhóm và hội đồng qua SignalR
VITE_ENABLE_CHAT=true

# 7. Đính kèm tệp và phản hồi biểu cảm trong Chat
VITE_ENABLE_CHAT_ATTACHMENTS=true

# 8. Quản lý công việc theo chuẩn Jira/Sprint/Backlog
VITE_ENABLE_JIRA_SPRINT=true

# 9. Lọc công việc theo chuyên ngành (BE-07 / Task Major Filter)
VITE_ENABLE_TASK_MAJOR_FILTER=true

# 10. Cổng kiểm soát tiến độ đồ án (BE-12 / Gates G1–G6)
VITE_ENABLE_GATES=true

# 11. Dữ liệu Review Gates: Dùng API ASP.NET Core thật (không dùng mock)
VITE_USE_MOCK_REVIEW_GATES=false

# 12. Thỏa thuận làm việc nhóm (BE-16 / Working Agreement)
VITE_ENABLE_WORKING_AGREEMENT=true

# 13. Bản đồ năng lực thống nhất (BE-10 / Unified Capabilities)
VITE_ENABLE_UNIFIED_CAPABILITIES=true

# 14. Gợi ý xếp hạng giảng viên hướng dẫn (BE-18 / Supervisor Recommendation)
VITE_ENABLE_SUPERVISOR_RECOMMENDATION=true

# 15. Lịch bảo vệ và hội đồng đánh giá (BE-14 / Defense Schedule)
VITE_ENABLE_DEFENSE=true

# 16. Chấm nguội và báo cáo COLD theo ngành (BE-N01 / Cold Report)
VITE_ENABLE_COLD_REPORT=true

# 17. Đánh giá tuần của GVHD chính (BE-N04 / Weekly Assessment)
VITE_ENABLE_WEEKLY_ASSESSMENT=true

# 18. Bộ môn chủ quản công bố điểm liên ngành (BE-03 / Lead Department Publish)
VITE_ENABLE_LEAD_PUBLISH=true

# 19. Phân quyền ma trận RBAC
VITE_ENABLE_RBAC_WRITE=false

# ------------------------------------------------------------------------------
# NHÓM 1: 3 Feature Flags GIỮ TẮT THEO QUYẾT ĐỊNH NGHIỆM THU Q6
# ------------------------------------------------------------------------------

# 1. Đánh giá đồng đội (PEER_EVAL):
# Tắt có chủ ý: chờ bộ môn duyệt chính sách đánh giá đồng đội chính thức (DECISIONS.md Q6)
VITE_ENABLE_PEER_EVAL=false

# 2. Phúc khảo điểm (RESULT_CORRECTION):
# Tắt có chủ ý: chờ bộ môn chốt quy trình và biểu mẫu phúc khảo chính thức (DECISIONS.md Q6)
VITE_ENABLE_RESULT_CORRECTION=false

# 3. Cố vấn doanh nghiệp (INDUSTRY):
# Tắt có chủ ý: chờ cấu hình Google OAuth Client ID staging và InvitationUrl production (DECISIONS.md Q6)
VITE_ENABLE_INDUSTRY=false
