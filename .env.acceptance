# G9 acceptance profile — REAL STAGING, not a read-only sandbox.
# Public configuration only, never credentials. Run with --mode acceptance.
# RBAC_WRITE and CHAT_ATTACHMENTS stay false below. Historical G9 probes enabled
# both only to inspect/read the UI; no permission save or file upload was tested.
# Remaining true flags can expose real writes when BE capabilities allow them:
# - AI_ADVISORY / AI_RUN_HISTORY: ask and persist AI analysis runs.
# - GATES: create/update checkpoints and submit checkpoint decisions.
# - WORKING_AGREEMENT: draft, publish and member acceptance.
# - DEFENSE: schedule/cancel sessions and manage committee assignments.
# - COLD_REPORT: templates, checklists, report drafts, files, submit and lock.
# - WEEKLY_ASSESSMENT: save/submit individual demo assessments.
# - MEETING_COLLABORATION / VIDEO_MEETING: series, RSVP, notes and video sessions.
# - CHAT: conversations, messages, edit/recall, read status and mute.
# - JIRA_SPRINT: sprint lifecycle and task-board changes.
# Repeating G9 UI/read probes: do not submit/save/send/upload/start/end/grade/
# publish/delete or change permissions on existing staging data. A GET smoke is not write
# acceptance. See docs/fe2/G9_ACCEPTANCE_2026-10-25.md for isolated replay steps.
# Flags only expose FE surfaces; the backend still decides all authorization.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=https://api-staging.khaidz.com
VITE_DATA_MODE=api
VITE_USE_MOCK_REVIEW_GATES=false

# VIDEO_MEETING was already enabled in the original self-test (outside the 19 flags).
VITE_ENABLE_VIDEO_MEETING=true

# Q6: 16 flags were probed historically; the 19-row handoff preserves those values.
# AI_ADVISORY is explicit here; PR #101 adds its opt-in entry to .env.example.
VITE_ENABLE_AI_ADVISORY=true
VITE_ENABLE_AI_RUN_HISTORY=true
VITE_ENABLE_SUPERVISOR_RECOMMENDATION=true
VITE_ENABLE_GATES=true
VITE_ENABLE_WORKING_AGREEMENT=true
VITE_ENABLE_UNIFIED_CAPABILITIES=true
VITE_ENABLE_TASK_MAJOR_FILTER=true
VITE_ENABLE_DEFENSE=true
VITE_ENABLE_COLD_REPORT=true
VITE_ENABLE_WEEKLY_ASSESSMENT=true
VITE_ENABLE_LEAD_PUBLISH=true
# Historical probe used true, read-only. Keep actual role-permission saving off.
VITE_ENABLE_RBAC_WRITE=false
VITE_ENABLE_MEETING_COLLABORATION=true
VITE_ENABLE_CHAT=true
# Historical probe used true; upload/download was NOT accepted. Keep uploads off.
VITE_ENABLE_CHAT_ATTACHMENTS=false
VITE_ENABLE_JIRA_SPRINT=true

# Q6: intentional holds, not technical acceptance gaps.
VITE_ENABLE_PEER_EVAL=false
VITE_ENABLE_RESULT_CORRECTION=false
VITE_ENABLE_INDUSTRY=false

# New PR #100 rollout is audited separately under G8; fixture sandbox is never live.
VITE_ENABLE_AI_ACADEMIC_ASSISTANT=false
VITE_ENABLE_WORKFLOW_PREVIEW=false
