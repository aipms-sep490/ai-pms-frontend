VITE_API_BASE_URL=/api/v1
# Optional local development proxy. Keep empty to use the local API on port 5080.
# VITE_API_PROXY_TARGET=https://api-staging.example.com
VITE_DATA_MODE=api
# Enables Video Meeting form/API contract rollout only after the matching Backend API is deployed.
# This flag never grants start/join/end/media permission.
VITE_ENABLE_VIDEO_MEETING=false

# Opt-in after BE chat SQL/REST/SignalR rollout. Mock mode never opens a real hub.
VITE_ENABLE_CHAT=false
# Chat file/image upload + reactions; requires the backend attachment/reaction contract.
VITE_ENABLE_CHAT_ATTACHMENTS=false
# Jira-style sprints/backlog/story points/labels; requires the backend sprint contract.
VITE_ENABLE_JIRA_SPRINT=false

# Checkpoint / Review Gate (G1–G6) screen. Enable only after BE-12 endpoints ship.
VITE_ENABLE_GATES=false

# Working Agreement screen (BE-16). Post-MVP; enable only after the endpoints ship.
VITE_ENABLE_WORKING_AGREEMENT=false

# Unified project capabilities map (BE-10). Enable once the FE migrates off the legacy action endpoints.
VITE_ENABLE_UNIFIED_CAPABILITIES=false

# Task filter by major / discipline role (BE-07). Enable after the tasks endpoint accepts majorId + disciplineRole.
VITE_ENABLE_TASK_MAJOR_FILTER=false

# Saved AI analysis run history (BE-15). Enable only after the /ai/runs endpoints ship.
VITE_ENABLE_AI_RUN_HISTORY=false

# Supervisor recommendation ranking (BE-18, advisory). Enable after the recommendation endpoints ship.
VITE_ENABLE_SUPERVISOR_RECOMMENDATION=false

# Defense schedule / committee screen (BE-14). Enable only after the defense-session endpoints ship.
VITE_ENABLE_DEFENSE=false

# Peer evaluation (BE-19b, evidence only). Enable after the peer-evaluation endpoints ship.
VITE_ENABLE_PEER_EVAL=false

# Result correction / appeal requests (BE-19b). Enable after the correction endpoints ship.
VITE_ENABLE_RESULT_CORRECTION=false

# Lead Department publishes cross-department results (BE-03). Enable only after BE-03 merges; removes the Admin publish CTA.
VITE_ENABLE_LEAD_PUBLISH=false

# RBAC matrix editing (BE-11). MVP = read-only matrix; enable to allow editing role permissions.
VITE_ENABLE_RBAC_WRITE=false
# Isolated fixture UX sandbox; also requires VITE_DATA_MODE=mock.
VITE_ENABLE_WORKFLOW_PREVIEW=false
