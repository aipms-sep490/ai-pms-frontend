VITE_API_BASE_URL=/api/v1
# Optional local development proxy. Keep empty to use the local API on port 5080.
# VITE_API_PROXY_TARGET=https://api-staging.example.com
VITE_DATA_MODE=api
# Enables Video Meeting form/API contract rollout only after the matching Backend API is deployed.
# This flag never grants start/join/end/media permission.
VITE_ENABLE_VIDEO_MEETING=false

# Opt-in after BE chat SQL/REST/SignalR rollout. Mock mode never opens a real hub.
VITE_ENABLE_CHAT=false
