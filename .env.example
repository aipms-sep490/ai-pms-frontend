VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=https://api-staging.khaidz.com
VITE_DATA_MODE=api
VITE_ENABLE_AI_ACADEMIC_ASSISTANT=false

# --- Flags below are verified-ready against BE develop as of 2026-10-13 (route + FE
# contract reconciliation both confirmed) and recommended on. This file is the committed
# template only — flipping a value here does not change a live deployment. Whoever owns
# the actual hosting environment still needs to set the matching VITE_ENABLE_* variable
# to `true` there for it to take effect. ---

# Video Meeting form/API contract rollout. Never grants start/join/end/media permission on its own.
VITE_ENABLE_VIDEO_MEETING=true

# Chat SQL/REST/SignalR. Mock mode never opens a real hub.
VITE_ENABLE_CHAT=true
# Chat file/image upload + reactions; backend attachment/reaction contract confirmed.
VITE_ENABLE_CHAT_ATTACHMENTS=true
# Jira-style sprints/backlog/story points/labels; backend sprint contract confirmed.
VITE_ENABLE_JIRA_SPRINT=true
# Meeting series/recurrence, RSVP and notes-lock collaboration (BE-06/N06/N07).
VITE_ENABLE_MEETING_COLLABORATION=true

# Checkpoint / Review Gate (G1–G6) screen (BE-12, served off AcademicTrackingController).
VITE_ENABLE_GATES=true
# Review Gates uses the real API by default. Set true explicitly for development-only sample data.
VITE_USE_MOCK_REVIEW_GATES=false

# Working Agreement screen (BE-16).
VITE_ENABLE_WORKING_AGREEMENT=true

# Unified project capabilities map (BE-10): my-capabilities / execution-actions endpoints confirmed.
VITE_ENABLE_UNIFIED_CAPABILITIES=true

# Task filter by major / discipline role (BE-07): tasks endpoint accepts majorId + disciplineRole.
VITE_ENABLE_TASK_MAJOR_FILTER=true

# Project AI advisory is opt-in. Enable after the matching advisory endpoints are
# deployed and the deployment owner deliberately enables the advisory rollout.
VITE_ENABLE_AI_ADVISORY=false

# Saved AI analysis run history (BE-15): GET /projects/{id}/ai/runs confirmed.
VITE_ENABLE_AI_RUN_HISTORY=true

# Supervisor recommendation ranking (BE-18, advisory only).
VITE_ENABLE_SUPERVISOR_RECOMMENDATION=true

# Defense schedule / committee screen (BE-14, served off AcademicTrackingController).
VITE_ENABLE_DEFENSE=true

# COLD report templates/checklist/draft/upload/submit (BE-N01).
VITE_ENABLE_COLD_REPORT=true
# Weekly individual demo assessment (BE-N04, Primary-supervisor-only).
VITE_ENABLE_WEEKLY_ASSESSMENT=true

# Peer evaluation (BE-19b, evidence only). Backend contract is ready, but this is a
# TEAM_SELECTED policy, not yet ACADEMIC_APPROVED — hold off until academic sign-off,
# not a technical blocker. See docs/handoff/BE_HANDOFF_REGISTRATION_RULES_2026-10-13.md.
VITE_ENABLE_PEER_EVAL=false

# Result correction / appeal requests (BE-19b). Same ACADEMIC_APPROVED hold as peer eval.
VITE_ENABLE_RESULT_CORRECTION=false

# Industry advisory (admin invitations, lead assignment, expert portal). Backend contract is
# ready, but module flags remain off on the shared backend and Google enrollment needs real
# provider config — hold off until both are confirmed, not a technical blocker.
VITE_ENABLE_INDUSTRY=false

# Lead Department publishes cross-department results (BE-03): result-policy + result endpoints confirmed.
VITE_ENABLE_LEAD_PUBLISH=true

# RBAC matrix editing (BE-11): full CRUD on roles/permissions confirmed.
VITE_ENABLE_RBAC_WRITE=true
# Isolated fixture UX sandbox; also requires VITE_DATA_MODE=mock.
VITE_ENABLE_WORKFLOW_PREVIEW=false
